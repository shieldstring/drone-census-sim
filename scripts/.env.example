# Path to the AirSim prebuilt environment executable.
# Windows example: C:\AirSim\Blocks\Blocks.exe
# Linux example:   /home/user/AirSim/Blocks/LinuxNoEditor/Blocks.sh
AIRSIM_BINARY_PATH=

# Extra command-line arguments passed to the AirSim binary on launch.
# -windowed -ResX=1280 -ResY=720 keeps it from grabbing the full screen.
AIRSIM_BINARY_ARGS=-windowed -ResX=1280 -ResY=720

# Seconds to wait after launching AirSim before the AI pipeline connects.
# Unreal environments can take 20-40s to finish loading on a cold start.
AIRSIM_BOOT_WAIT=30

# Set this on a machine with NO local AirSim binary (e.g. macOS) to point
# at AirSim running on a separate Windows/Linux machine on the same network.
AIRSIM_HOST=
