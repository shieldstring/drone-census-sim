# AirSim Unreal environment for census simulation.
# CityEnviron = large city with vehicles AND pedestrians (default, multi-GB).
# AirSimNH = urban neighborhood streets (smaller download).
# Blocks = empty cubes (NO people) - do not use for counting demos.
AIRSIM_ENV_NAME=CityEnviron

# Path to the AirSim prebuilt environment executable (or run.bat).
# Windows example: C:\drone-census-sim\airsim_env\CityEnviron\...\CityEnviron.exe
# Filled automatically by scripts\setup_airsim.ps1
AIRSIM_BINARY_PATH=

# Extra command-line arguments passed to the AirSim binary on launch.
# -windowed -ResX=1280 -ResY=720 keeps it from grabbing the full screen.
AIRSIM_BINARY_ARGS=-windowed -ResX=1280 -ResY=720

# Seconds to wait after launching AirSim before the AI pipeline connects.
# CityEnviron can take 40-90s on a cold start.
AIRSIM_BOOT_WAIT=45

# Set this on a machine with NO local AirSim binary (e.g. macOS) to point
# at AirSim running on a separate Windows/Linux machine on the same network.
AIRSIM_HOST=
